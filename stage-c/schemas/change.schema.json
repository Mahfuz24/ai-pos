{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^CR-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "impact_review",
        "approved",
        "implementing",
        "verifying",
        "closed",
        "rejected",
        "deferred",
        "blocked"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "origin_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "change_class": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "affected_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision",
    "origin_batch",
    "change_class",
    "reason",
    "affected_ids",
    "approval_ref"
  ],
  "allOf": [
    {
      "properties": {
        "id": {
          "pattern": "^CR-[0-9]{3,}$"
        },
        "owner_batch": {
          "const": "B01"
        }
      }
    }
  ]
}
