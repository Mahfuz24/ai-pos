{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ACC-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "blocked",
        "not_applicable",
        "superseded"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "criterion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_defect_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision",
    "requirement_id",
    "criterion_ids",
    "candidate_sha",
    "evidence_ids",
    "unresolved_defect_ids"
  ],
  "allOf": [
    {
      "properties": {
        "id": {
          "pattern": "^ACC-[0-9]{3,}$"
        },
        "owner_batch": {
          "const": "B06"
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "candidate_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "candidate_sha",
          "evidence_ids"
        ]
      }
    }
  ]
}
