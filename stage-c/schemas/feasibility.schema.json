{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^FEAS-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "blocked",
        "not_applicable"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision",
    "subject_ids",
    "dimensions",
    "evidence_ids",
    "recommendation"
  ],
  "allOf": [
    {
      "properties": {
        "id": {
          "pattern": "^FEAS-[0-9]{3,}$"
        },
        "owner_batch": {
          "const": "B03"
        }
      }
    }
  ]
}
