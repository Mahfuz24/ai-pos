{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVD-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "evidence_type": {
      "type": "string"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment_id": {
      "type": "string"
    },
    "result": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ]
    },
    "test_id": {
      "type": "string",
      "pattern": "^TEST-[0-9]{3,}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision",
    "producer_batch",
    "evidence_type",
    "source_sha",
    "environment_id",
    "result",
    "artifact_refs",
    "artifact_hashes"
  ],
  "allOf": [
    {
      "properties": {
        "id": {
          "pattern": "^EVD-[0-9]{3,}$"
        },
        "owner_batch": {
          "const": "B06"
        }
      }
    }
  ]
}
