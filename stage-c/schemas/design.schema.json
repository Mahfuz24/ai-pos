{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DSN-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "under_review",
        "approved",
        "implemented",
        "superseded"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "component_name": {
      "type": "string"
    },
    "supported_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsive_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision",
    "component_name",
    "supported_states",
    "responsive_rules",
    "requirement_ids"
  ],
  "allOf": [
    {
      "properties": {
        "id": {
          "pattern": "^DSN-[0-9]{3,}$"
        },
        "owner_batch": {
          "const": "B04"
        }
      }
    }
  ]
}
