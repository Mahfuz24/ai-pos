{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "owner_batch": {
      "enum": [
        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "owner_batch",
    "title",
    "status",
    "revision"
  ],
  "additionalProperties": false
}